# Host-side folders are mounted into Docker Compose.
APP_PORT=8501

# Kokoro Brazilian Portuguese. The UI offers Dora, Alex and Santa.
TTS_DEVICE=cuda
TTS_VOICE=pf_dora
CHATTERBOX_DEVICE=cuda
CHATTERBOX_BASE_REPO=ResembleAI/chatterbox
CHATTERBOX_PTBR_REPO=ResembleAI/Chatterbox-Multilingual-pt-br
# O primeiro uso baixa os pesos; o cache fica persistente em models/kokoro.
CHATTERBOX_CACHE_DIR=/root/.cache/huggingface/local-short-studio/chatterbox-ptbr
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_CACHE_DIR=/root/.cache/huggingface/whisper

# `auto` selects NVENC when FFmpeg sees it; `libx264` is the compatibility option.
VIDEO_ENCODER=auto

# ZIP safety limits.
ZIP_MAX_FILES=100
ZIP_MAX_COMPRESSED_BYTES=262144000
ZIP_MAX_UNCOMPRESSED_BYTES=1073741824
ZIP_MAX_IMAGE_BYTES=52428800
ZIP_MAX_IMAGE_PIXELS=40000000
