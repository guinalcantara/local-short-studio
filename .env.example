# Host-side folders are mounted into Docker Compose.
COMFYUI_PORT=8188
APP_PORT=8501

# Set this to the exact checkpoint filename in models/checkpoints/.
CHECKPOINT_NAME=sd-v1-5-pruned-emaonly-fp16.safetensors

# Local image generation defaults for a 6 GB RTX 2060.
IMAGE_WIDTH=512
IMAGE_HEIGHT=896
IMAGE_STEPS=18
IMAGE_CFG=6.5

# Kokoro Brazilian Portuguese. Voice options depend on the installed model build.
TTS_DEVICE=cuda
TTS_VOICE=pf_dora

# `auto` selects NVENC when FFmpeg sees it; `libx264` is the compatibility option.
VIDEO_ENCODER=auto
